generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  name          String?
  email         String         @unique
  emailVerified DateTime?      @db.Timestamptz(6)
  image         String?
  password      String?
  role          Role           @default(CUSTOMER)
  isActive      Boolean        @default(true)
  phone         String?
  organization  String?
  createdAt     DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  accounts      Account[]
  addresses     Address[]
  cartItems     CartItem[]
  orders        Order[]
  reviews       Review[]
  sessions      Session[]
  wishlist      WishlistItem[]
}

model Account {
  id                String  @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([provider, providerAccountId])
  @@index([userId], map: "idx_account_user")
}

model Session {
  id           String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  sessionToken String   @unique
  userId       String
  expires      DateTime @db.Timestamptz(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz(6)

  @@unique([identifier, token])
}

model Category {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  name        String
  slug        String    @unique
  description String?
  image       String?
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  products    Product[]
}

model Product {
  id             String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  name           String
  slug           String         @unique
  sku            String         @unique
  categoryId     String
  brandId        String?
  manufacturer   String?
  price          Float
  discountPrice  Float?
  dealerPrice    Float?
  retailPrice    Float?
  images         String[]       @default([])
  shortDesc      String?        @map("shortDescription")
  description    String?
  specifications Json?
  features       String[]       @default([])
  accessories    String[]       @default([])
  indications    String[]       @default([])
  clinicalEvidence String[]     @default([])
  isAvailable    Boolean        @default(true)
  stockQty       Int            @default(0) @map("stock")
  weight         Float?
  dimensions     String?
  warranty       String?
  isFeatured     Boolean        @default(false)
  seoTitle       String?
  seoDesc        String?        @map("seoDescription")
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  cartItems      CartItem[]
  orderItems     OrderItem[]
  category       Category       @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reviews        Review[]
  wishlistItems  WishlistItem[]

  @@index([categoryId], map: "idx_product_category")
  @@index([sku], map: "idx_product_sku")
  @@index([slug], map: "idx_product_slug")
}

model Order {
  id              String      @id @default(dbgenerated("(gen_random_uuid())::text"))
  orderNumber     String      @unique
  userId          String
  status          OrderStatus @default(PENDING)
  subtotal        Float
  shipping        Float       @default(0) @map("shippingCost")
  tax             Float       @default(0)
  discount        Float       @default(0)
  total           Float
  couponCode      String?
  shippingAddress Json
  notes           String?
  createdAt       DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime    @default(now()) @updatedAt @db.Timestamptz(6)
  user            User        @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items           OrderItem[]

  @@index([status], map: "idx_order_status")
  @@index([userId], map: "idx_order_user")
}

model OrderItem {
  id        String  @id @default(dbgenerated("(gen_random_uuid())::text"))
  orderId   String
  productId String
  price     Float
  quantity  Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product   Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model CartItem {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String
  productId String
  quantity  Int      @default(1)
  product   Product  @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, productId])
  @@index([userId], map: "idx_cartitem_user")
}

model WishlistItem {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, productId])
  @@index([userId], map: "idx_wishlist_user")
}

model Address {
  id        String  @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String
  name      String  @map("fullName")
  phone     String
  street    String
  city      String
  state     String
  zip       String  @map("zipCode")
  country   String  @default("US")
  label     String  @default("Home")
  isDefault Boolean @default(false)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Review {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String
  productId String
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  product   Product  @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([productId], map: "idx_review_product")
}

model DemoRequest {
  id            String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  productName   String
  productSlug   String?
  fullName      String
  email         String
  phone         String?
  organization  String?
  cityState     String?
  role          String?
  demoFormat    String?
  contactMethod String?
  interest      String?
  message       String?
  consent       Boolean  @default(false)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  @@index([email], map: "idx_demo_request_email")
  @@index([productSlug], map: "idx_demo_request_product")
}

model ContactMessage {
  id           String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  name         String   @map("fullName")
  email        String
  phone        String?
  jobTitle     String?
  organization String?
  address      String?
  workLocation String?
  subject      String
  message      String
  isRead       Boolean  @default(false)
  reply        String?
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
}

model Coupon {
  id        String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  code      String     @unique
  type      CouponType @default(PERCENTAGE)
  value     Float
  minOrder  Float?
  maxUses   Int?
  usedCount Int        @default(0)
  isActive  Boolean    @default(true)
  expiresAt DateTime?  @db.Timestamptz(6)
  createdAt DateTime   @default(now()) @db.Timestamptz(6)
}

model HeroSlide {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  title       String
  description String?
  image       String
  buttonText  String?
  buttonLink  String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}

model SiteSetting {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  key       String   @unique
  value     String
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}

model NavItem {
  id       String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  label    String
  href     String
  order    Int       @default(0)
  isActive Boolean   @default(true)
  parentId String?
  parent   NavItem?  @relation("NavChildren", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children NavItem[] @relation("NavChildren")
}

model ProfessionalConnection {
  id           String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  fullName     String
  email        String
  phone        String?
  organization String?
  role         String?
  interest     String?
  message      String?
  consent      Boolean  @default(false)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  @@index([email], map: "idx_professional_connection_email")
}

model Newsletter {
  id           String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  email        String   @unique
  name         String?
  phone        String?
  address      String?
  jobTitle     String?
  organization String?
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
}

model Facility {
  id                 String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  epgMemberNumber    String    @unique
  facilityName       String
  groupAffiliation   String?
  address            String?
  city               String?
  state              String?
  zipCode            String?
  effectiveDate      DateTime? @db.Timestamptz(6)
  facilityType       String?
  contactName        String?
  contactTitle       String?
  email              String?
  phone              String?
  createdAt          DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([email])
  @@index([state])
}

model MediaFile {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  url       String
  publicId  String
  name      String
  size      Int?
  mimeType  String?
  folder    String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
}

model ProductSubmission {
  id              String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  referenceNumber String           @unique

  // Product information
  productName     String
  category        String
  manufacturer    String
  modelNumber     String?
  modelYear       String?
  serialNumber    String?
  quantity        String?
  condition       String
  location        String?
  description     String?
  askingPrice     String?

  // Photos — array of { publicId, label, url }
  images          Json             @default("[]")

  // Contact information
  fullName        String
  companyName     String?
  email           String
  phone           String
  preferredContact String?
  country         String?
  city            String?
  comments        String?

  // Consent
  consentAccurate  Boolean @default(false)
  consentRight     Boolean @default(false)
  consentNoPhi     Boolean @default(false)
  consentContact   Boolean @default(false)
  consentPrivacy   Boolean @default(false)

  status          SubmissionStatus @default(NEW)
  adminNotes      String?

  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([email], map: "idx_product_submission_email")
  @@index([status], map: "idx_product_submission_status")
}

enum SubmissionStatus {
  NEW
  REVIEWING
  ACCEPTED
  DECLINED
}

enum Role {
  SUPER_ADMIN
  ADMIN
  CONTENT_MANAGER
  CUSTOMER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum CouponType {
  PERCENTAGE
  FIXED
}
