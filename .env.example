# Database
DATABASE_URL="postgresql://username:password@localhost:5432/medpharma"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Email — preferred: Resend (used automatically when RESEND_API_KEY is set)
RESEND_API_KEY="re_your_api_key"

# Email — fallback: SMTP via Nodemailer (used only if RESEND_API_KEY is not set)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# Shared "from" address, used by both Resend and SMTP
SMTP_FROM="MP MedPharma <noreply@mpmedpharma.com>"

# Stripe (optional)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Cron (product digest email) — generate with: openssl rand -base64 32
# Vercel automatically sends this as a Bearer token when triggering /api/cron/*
CRON_SECRET="your-cron-secret-here"

# Sell Your Product submissions (optional — both default to dr.mohamed8181@gmail.com)
PRODUCT_SUBMISSION_NOTIFY_EMAIL="info@mpmedpharma.com"
NEXT_PUBLIC_SUPPORT_EMAIL="info@mpmedpharma.com"

# Contact form / product inquiries (optional — defaults to PRODUCT_SUBMISSION_NOTIFY_EMAIL, then dr.mohamed8181@gmail.com)
CONTACT_NOTIFY_EMAIL="info@mpmedpharma.com"

# Measurement & search-engine verification (all optional; nothing is emitted when unset)
# GA4 measurement ID from Google Analytics → Admin → Data streams (starts with G-)
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
# Content of the google-site-verification meta tag from Google Search Console → Settings → Ownership verification → HTML tag
GOOGLE_SITE_VERIFICATION=""
# Content of the msvalidate.01 meta tag from Bing Webmaster Tools → Settings → Verify ownership → HTML meta tag
BING_SITE_VERIFICATION=""
